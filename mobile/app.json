{
  "expo": {
    "name": "xcare",
    "slug": "xcare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563eb"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.xcare.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Für Dokumenten-Scan und Video-Konsultation",
        "NSMicrophoneUsageDescription": "Für Video-Konsultation und Sprachassistent",
        "NSLocationWhenInUseUsageDescription": "Zur Anzeige naher Pflegeanbieter",
        "NSHealthShareUsageDescription": "Für Vitaldaten-Import aus Apple Health",
        "NSHealthUpdateUsageDescription": "Zum Speichern von Vitaldaten in Apple Health"
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.associated-domains": ["applinks:xcare.app"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563eb"
      },
      "package": "app.xcare.mobile",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-location",
      ["expo-camera", { "cameraPermission": "Für Dokumenten-Scan und Video-Konsultation" }]
    ],
    "extra": {
      "supabaseUrl": "https://your-project.supabase.co",
      "supabaseAnonKey": "your-anon-key",
      "eas": { "projectId": "your-eas-project-id" }
    },
    "scheme": "xcare",
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
